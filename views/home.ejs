<% layout('/layouts/boilerplate') %>

<main class="auth-shell auth-home-shell">
    <section class="auth-welcome auth-home-welcome">
        <a class="auth-brand" href="/home"><img src="/home.jpg" alt="StayVista"></a>
        <div class="auth-welcome-copy">
            <p class="auth-eyebrow">YOUR NEXT CHAPTER STARTS HERE</p>
            <h1>Welcome to<br>StayVista</h1>
            <p>Find a place that feels like yours. Discover stays worth remembering, wherever you want to go.</p>
        </div>
        <div class="auth-home-actions">
            <p class="auth-welcome-footer">Find your place. Make yourself at home.</p>
            <a class="btn auth-submit auth-next-button" href="/listings">Next <span aria-hidden="true">&rarr;</span></a>
        </div>
    </section>
</main>
