<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
    <div class="container-fluid">
        <a class="navbar-brand" href="/home">
            <img src="/home.jpg" alt="StayVista Logo" class="logo">
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup"
            aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
            <div class="navbar-nav align-items-md-center w-100">
                <a class="nav-link" href="/listings">All Listings</a>
                <a class="nav-link" href="/listings/new">Add new Listing</a>
                <form class="d-flex searchbar ms-md-auto" role="search" action="/listings" method="GET">
                    <input class="form-control me-2" id="nav-place" type="search" name="place" placeholder="Search places"
                        aria-label="Search places" value="<%= typeof filters !== 'undefined' ? filters.place : '' %>">
                    <button class="btn btn-outline-success" type="submit">Search</button>
                </form>
                <% if (currentUser) { %>
                    <div class="dropdown ms-md-3">
                        <button class="btn user-avatar" type="button" id="userMenu" data-user-avatar="<%= currentUser._id %>"
