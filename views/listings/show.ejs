<% layout('/layouts/boilerplate')%>

    <div class="row mt-2">
        <div class="col-8 offset-2">
            <h3>Listing Details :</h3>
        </div>

        <div class="card show-card col-8 offset-2">
            <img src="<%= listing.image.url%>" class="card-img-top show-img" alt="listing_image">
            <div class="card-body">
                <p class="card-text">
                    <b>
                        <%= listing.title %>
                    </b>
                    <br>
                    <%= listing.description%><br> &#8377
                        <%= (listing.price ?? 0).toLocaleString("en-IN") %> / night<br>
                            <%= listing.location%><br>
                                <%= listing.country%>
                </p>
            </div>
        </div>
        <% if (currentUser) { %>
            <div class="listing-actions d-flex align-items-start gap-2 col-8 offset-2">
                <a href="/listings/<%=listing._id %>/edit" class="btn btn-outline-success edit-btn">Edit</a>
                <form method="POST" action="/listings/<%=listing._id %>?_method=DELETE">
                    <button class="btn btn-danger">Delete</button>
                </form>
            </div>
        <% } %>
    </div>
    </div>